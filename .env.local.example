# Local file mode — no database required.
# Copy to .env.local or use: npm run dev:local

VITE_DATA_SOURCE=local

# Optional: change where data is served from (default /data → public/data/)
# VITE_LOCAL_DATA_ROOT=/data

# Supabase (only needed when VITE_DATA_SOURCE=supabase)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# VITE_SUPABASE_TABLE=pipeline_runs
